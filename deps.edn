{:paths ["src" "test"]
 :aliases {:test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                    :main-opts ["-m" "kaocha.runner"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.0"}}
                   :ns-default build}
           :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                    :exec-fn deps-deploy.deps-deploy/deploy
                    :exec-args {:installer :remote
                                :sign-releases? true
                                :artifact "java-http.jar"}}
           :install {:deps {io.github.clojure/tools.build {:mvn/version "0.10.0"}}
                     :ns-default build
                     :exec-fn build/install}}}
